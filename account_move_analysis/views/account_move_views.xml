<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_move_invoice_graph" model="ir.ui.view">
        <field name="name">account.move.invoice.graph</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <graph string="Análisis de facturación" type="bar" sample="1">
                <field name="invoice_date" interval="month"/>
                <field name="amount_total_signed" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_account_move_invoice_pivot" model="ir.ui.view">
        <field name="name">account.move.invoice.pivot</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de facturación" sample="1">
                <field name="partner_id" type="row"/>
                <field name="invoice_date" type="col"/>
                <field name="amount_untaxed_signed" type="measure"/>
                <field name="amount_total_signed" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="account.action_move_out_invoice_type" model="ir.actions.act_window">
        <field name="view_mode">tree,kanban,form,pivot,graph,activity</field>
    </record>

    <record id="account.action_move_out_refund_type" model="ir.actions.act_window">
        <field name="view_mode">tree,kanban,form,pivot,graph,activity</field>
    </record>

    <record id="account.action_move_in_invoice_type" model="ir.actions.act_window">
        <field name="view_mode">tree,kanban,form,pivot,graph,activity</field>
    </record>

    <record id="account.action_move_in_refund_type" model="ir.actions.act_window">
        <field name="view_mode">tree,kanban,form,pivot,graph,activity</field>
    </record>

    <record id="account.action_move_out_receipt_type" model="ir.actions.act_window">
        <field name="view_mode">tree,kanban,form,pivot,graph,activity</field>
    </record>

    <record id="account.action_move_in_receipt_type" model="ir.actions.act_window">
        <field name="view_mode">tree,kanban,form,pivot,graph,activity</field>
    </record>

</odoo>
