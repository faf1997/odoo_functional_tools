<odoo>
  <data>
    <record id="resource_calendar_leaves_tree_inherit_public_holiday" model="ir.ui.view">
        <field name="name">resource.calendar.leaves.tree.inherit.public.holiday</field>
        <field name="model">resource.calendar.leaves</field>
        <field name="inherit_id" ref="resource.resource_calendar_leave_tree"/>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="country_id"/>
            </xpath>
        </field>
    </record>
  </data>
</odoo>
