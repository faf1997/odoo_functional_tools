<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_holidays" model="ir.cron">
            <field name="name">Feriados: Buscar y registrar feriados argentinos</field>
            <field name="model_id" ref="model_resource_calendar_leaves"/>
            <field name="state">code</field>
            <field name="code">model.create_holidays()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
            <field name="priority" eval="0" />
        </record>

    </data>
</odoo>

