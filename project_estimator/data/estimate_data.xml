<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_estimate" model="ir.sequence">
            <field name="name">Estimate Sequence</field>
            <field name="code">estimate.sequence</field>
            <field name="prefix">EST</field>
            <field name="padding">5</field>
        </record>

        <record id="estimate_tag_base_fast" model="estimate.tags">
            <field name="name">Fast</field>
            <field name="hours">2</field>
        </record>

        <record id="estimate_tag_base_intermediate" model="estimate.tags">
            <field name="name">Intermediate</field>
            <field name="hours">4</field>
        </record>

        <record id="estimate_tag_base_difficult" model="estimate.tags">
            <field name="name">Difficult</field>
            <field name="hours">8</field>
        </record>

        <record id="estimate_tag_base_very_difficult" model="estimate.tags">
            <field name="name">Very Difficult</field>
            <field name="hours">16</field>
        </record>
        
    </data>
</odoo>
