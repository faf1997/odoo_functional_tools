<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_wizard_estimate_lines_form" model="ir.ui.view">
            <field name="name">wizard.estimate.lines.form</field>
            <field name="model">wizard.estimate.lines</field>
            <field name="arch" type="xml">
                <form string="Assign Hours by Percentage">
                    <group>
                        <field name="total_hours" widget="float_time"/>
                    </group>
                    <field name="estimate_line_ids" options="{
                               'no_create': True,
                               'no_create_edit': True,
                               'no_quick_create': True,
                               'unlink': False,
                               'no_open': True
                           }">
                        <tree editable="bottom" create="0" delete="0">
                            <field name="name"/>
                            <field name="percent" required="1"/>
                            <field name="hours" widget="float_time"/>
                        </tree>
                    </field>
                    <footer>
                        <button name="assign_hours" string="Assign Hours" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_wizard_estimate_lines" model="ir.actions.act_window">
            <field name="name">Assign Hours by Percentage</field>
            <field name="res_model">wizard.estimate.lines</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
