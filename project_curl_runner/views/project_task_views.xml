<odoo>
    <record id="view_task_form_curl_button" model="ir.ui.view">
        <field name="name">project.task.form.curl.button</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_view_task_curls"
                        type="object"
                        string="Ver automatizaciones"
                        class="btn-primary"
                        />
                        <!-- context="{'reload': True }" -->
            </xpath>

            <xpath expr="//form/sheet/notebook" position="inside">
                <page string="Automatizaciones">
                    <group>
                        <field name="curl_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}" readonly="1"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>
</odoo>