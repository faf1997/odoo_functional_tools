<odoo>
    <record id="view_project_form_param_button" model="ir.ui.view">
        <field name="name">project.project.form.curl.button</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">
                <field name="is_template" invisible="1"/>
            </xpath>

            <xpath expr="//header" position="inside">
                <button name="action_deploy_proyect"
                        type="object"
                        string="Lanzar proyecto"
                        class="btn-primary"
                        invisible="is_template"/>

            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Parámetros del proyecto" invisible="is_template">

                    <field name="config_parameter_ids">
                        <tree editable="bottom">
                        <field name="key"/>
                        <field name="value"/>
                        </tree>
                        <form>
                        <sheet>
                            <group>
                            <field name="key"/>
                            <field name="value" widget="text"/>
                            </group>
                        </sheet>
                        </form>
                    </field>
                </page>
            </xpath>

        </field>
    </record>
</odoo>