<odoo>

    <record id="view_curl_task_form" model="ir.ui.view">
        <field name="name">curl.task.form</field>
        <field name="model">curl.task</field>
        <field name="arch" type="xml">
            <form string="Curl Task">
                <header>
                    <button name="action_curl_to_request"
                            type="object"
                            string="Curl a request"
                            class="btn-primary"/>
                    <button name="prepare_ir_actions_server_record"
                            type="object"
                            string="Render ir.actions.server"
                            class="btn-primary"/>

                    <button name="launch_action_server"
                            type="object"
                            string="Run ir.actions.server"
                            class="btn-primary"
                            invisible="action_server_id == False"/>
                            
                </header>
                <sheet>
                    <group>
                        <field name="sequence" invisible="1"/>
                        <field name="id"/>
                        <field name="name"/>
                        <field name="model_id"/>
                        <field name="status_code"/>
                        <field name="status"/>
                        <field name="action_server_id" readonly="1"/>
                        <field name="project_task_ids" readonly="1" invisible="1"/>
                    </group>
                    <!-- Notebook dentro del PRIMER group -->
                        <notebook>
                            <page string="Parámetros">
                                <field name="config_parameter_ids">
                                    <tree editable="bottom">
                                    <field name="key"/>
                                    <field name="value"/>
                                    </tree>
                                    <form>
                                    <sheet>
                                        <group>
                                        <field name="key"/>
                                        <field name="value" widget="text"/>
                                        </group>
                                    </sheet>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                </sheet>
                <notebook>
                    <page string="Curl">
                        <group>
                            <field name="command" widget="code" options="{'mode': 'python'}"/>
                            <field name="code" widget="code" options="{'mode': 'python'}"/>
                        </group>
                    </page>
                </notebook>
            </form>
        </field>
    </record>

    <record id="view_curl_task_tree" model="ir.ui.view">
        <field name="name">curl.task.tree</field>
        <field name="model">curl.task</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="status_code"/>
                <field name="status"/>
                <field name="action_server_id"/>
            </tree>
        </field>
    </record>

    <record id="action_curl_task" model="ir.actions.act_window">
        <field name="name">Curl Tasks</field>
        <field name="res_model">curl.task</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_curl_task_tree"/>
    </record>

