<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_report_estimate" model="ir.actions.report">
            <field name="name">Estimate</field>
            <field name="model">estimate</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">project_curl_runner.report_estimate_template</field>
            <field name="report_file">project_curl_runner.report_estimate_template</field>
            <field name="binding_model_id" ref="model_estimate"/>
            <field name="binding_type">report</field>
        </record>

        <template id="report_estimate_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-foreach="doc.get_paged_lines()" t-as="page_lines" t-as-i="page_lines_index">
                        <t t-call="web.external_layout">
                            <div class="page">
                                <div class="oe_structure"/>
                                <div class="row">
                                    <div class="col-xs-6">
                                        <strong t-field="doc.name"/>
                                    </div>
                                    <div class="col-xs-6 text-right">
                                        <img t-if="doc.logo" t-att-src="image_data_uri(doc.logo)" style="max-height: 100px;"/>
                                    </div>
                                </div>

                                <table class="table table-condensed" style="margin-top: 20px;">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Description</th>
                                            <th class="text-right">Hours</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="page_lines" t-as="line">
                                            <tr>
                                                <td><span t-field="line.name"/></td>
                                                <td><span t-field="line.description"/></td>
                                                <td class="text-right"><span t-field="line.hours"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>

                                <div class="row" t-if="page_lines_index == len(doc.get_paged_lines()) - 1">
                                    <div class="col-xs-4 pull-right">
                                        <table class="table table-condensed">
                                            <tr class="border-black">
                                                <td><strong>Total Hours</strong></td>
                                                <td class="text-right">
                                                    <span t-field="doc.total_hours"/>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
