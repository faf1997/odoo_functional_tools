<odoo>
    <record id="view_window_deploy_project_form" model="ir.ui.view">
        <field name="name">window.deploy.project.form</field>
        <field name="model">window.deploy.project</field>
        <field name="arch" type="xml">
            <form string="Deploy Project">
                <group>
                    <field name="project_id"/>
                </group>
                <group>
                    <field name="config_parameter_ids" options="{'no_open': True, 'no_create_edit': True}">
                        <tree editable="top" create="1" delete="1" multi_edit="1" string="Chart of accounts" open_form_view="True">
                            <field name="key"/>
                            <field name="value" widget="password"/>
                        </tree>
                    </field>
                </group>
                <footer>
                    <button name="action_launch"
                            string="Lanzar proyecto"
                            type="object"
                            class="btn-primary"/>

                    <button name="action_save_in_project"
                            string="Guardar"
                            type="object"
                            class="btn-secondary"/>

                    <button name="action_cancel"
                            string="Cancelar"
                            type="object"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
