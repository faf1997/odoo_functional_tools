<odoo>
    <record id="action_secret_secret" model="ir.actions.act_window">
        <field name="name">Credenciales</field>
        <field name="res_model">secret.secret</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
        <field name="context">{}</field>
    </record>
    
    <record id="project_project_form_inherit_secret_button" model="ir.ui.view">
        <field name="name">project.project.form.inherit.secret.button</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']/button[@name='action_view_tasks']" position="after">
                <button
                    name="action_view_partner_secrets"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-key"
                    groups="secret_management.group_secret_user,secret_management.group_secret_manager"
                >
                    <field name="secret_count" widget="statinfo" string="Credenciales" groups="secret_management.group_secret_user,secret_management.group_secret_manager"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>