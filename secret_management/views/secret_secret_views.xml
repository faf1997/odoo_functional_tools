<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_secret_secret_tree" model="ir.ui.view">
            <field name="name">secret.secret.tree</field>
            <field name="model">secret.secret</field>
            <field name="arch" type="xml">
                <tree string="Client Credentials">
                    <field name="partner_id"/>
                    <field name="key"/>
                    <field name="value"/>
                    <field name="active" column_invisible="1"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_secret_secret_form" model="ir.ui.view">
            <field name="name">secret.secret.form</field>
            <field name="model">secret.secret</field>
            <field name="arch" type="xml">
                <form string="Client Credential">
                    <sheet>
                        <group>
                            <group>
                                <field name="partner_id" 
                                       options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="key"/>
                            </group>
                            <group>
                                <field name="value" password="True"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View with Filters -->
        <record id="view_secret_secret_search" model="ir.ui.view">
            <field name="name">secret.secret.search</field>
            <field name="model">secret.secret</field>
            <field name="arch" type="xml">
                <search string="Search Credentials">
                    <field name="partner_id"/>
                    <field name="key"/>
                    <field name="value"/>
                    
                    <filter string="Archived" name="inactive" 
                            domain="[('active', '=', False)]"/>
                    
                    <separator/>
                    
                    <group expand="0" string="Group By">
                        <filter string="Partner" name="group_by_partner" 
                                context="{'group_by': 'partner_id'}"/>
                        <filter string="Key" name="group_by_key" 
                                context="{'group_by': 'key'}"/>
                        <filter string="Value" name="group_by_value" 
                                context="{'group_by': 'value'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_secret_secret" model="ir.actions.act_window">
            <field name="name">Client Credentials</field>
            <field name="res_model">secret.secret</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_secret_secret_search"/>
            <field name="context">{'search_default_group_by_partner': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first client credential
                </p>
                <p>
                    Store and manage client credentials securely with key-value pairs
                    associated to specific partners.
                </p>
            </field>
        </record>
    </data>
</odoo>
