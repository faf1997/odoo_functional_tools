<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Category for Secret Management -->
        <record id="module_category_secret_management" model="ir.module.category">
            <field name="name">Credenciales de proyectos</field>
            <field name="description">Gestión de credenciales del cliente en proyectos</field>
            <field name="sequence">50</field>
        </record>

        <!-- Group: Secret User (Read Only) -->
        <record id="group_secret_user" model="res.groups">
            <field name="name">Solo lectura</field>
            <field name="category_id" ref="module_category_secret_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Este grupo permite solo lectura de credenciales</field>
        </record>

        <!-- Group: Secret Manager (Full Access) -->
        <record id="group_secret_manager" model="res.groups">
            <field name="name">Acceso completo</field>
            <field name="category_id" ref="module_category_secret_management"/>
            <field name="implied_ids" eval="[(4, ref('group_secret_user'))]"/>
            <field name="comment">Este grupo permite acceso total a las credenciales de los proyectos</field>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Access Rules for Secret User (Read Only) -->
        <record id="secret_secret_rule_user" model="ir.rule">
            <field name="name"> Lector de credenciales en proyectos: Solo lectura</field>
            <field name="model_id" ref="model_secret_secret"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_secret_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Access Rules for Secret Manager (Full Access) -->
        <record id="secret_secret_rule_manager" model="ir.rule">
            <field name="name">Administrador de credenciales en proyectos: Acceso completo</field>
            <field name="model_id" ref="model_secret_secret"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_secret_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
