<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Heredamos la vista product_template_only_form_view -->
  <record id="product_template_only_form_view_inherit_route_ids" model="ir.ui.view">
    <field name="name">product.template.only.form.route.ids.inherit</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view"/>
    <field name="arch" type="xml">
      <!-- 1) Añadir un widget de etiquetas -->
      <xpath expr="//group[@name='packaging']" position="before">
        <group name="multipacks" string="Compra y venta por múltiplos de embalaje">
            <field name="is_sellable_in_multipacks"/>
            <field name="is_purchasable_in_multipacks"/>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
