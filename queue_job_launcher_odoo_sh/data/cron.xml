<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_collection_agent" model="ir.cron">
            <field name="name">Launch queue_job</field>
            <field name="model_id" ref="model_queue_job"/>
            <field name="state">code</field>
            <!-- Verificamos que el proceso queue_job se esté ejecutando -->
            <field name="code">model.launch_queue_job()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
        </record>
    </data>
</odoo>
